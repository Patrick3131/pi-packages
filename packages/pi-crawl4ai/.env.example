# pi-crawl4ai Configuration
# Copy this file to .env or use a JSON config file (recommended)

# ============================================
# JSON CONFIG (RECOMMENDED)
# ============================================
# Create a JSON config file instead of env vars:
#
# Option 1: Project-level config
#   .pi/crawl4ai.json
#
# Option 2: Global config
#   ~/.pi/agent/extensions/crawl4ai.json
#
# Example JSON config:
# {
#   "url": "http://localhost:11235",
#   "timeoutMs": 60000,
#   "apiToken": "${CRAWL4AI_API_TOKEN}"
# }
#
# Egress/proxy is owned by the crawl4ai server (operator pinning proxy).
# Do not configure client-side proxy credentials in this package.

# ============================================
# ENVIRONMENT VARIABLES (FALLBACK)
# ============================================

# REQUIRED: crawl4ai Docker API URL or remote API URL
CRAWL4AI_BASE_URL=http://localhost:11235

# OPTIONAL: crawl4ai Docker/API bearer token (required when server auth is enabled)
# Sent as: Authorization: Bearer <token>
# CRAWL4AI_API_TOKEN=your-crawl4ai-api-token

# OPTIONAL: Request timeout in milliseconds
# CRAWL4AI_TIMEOUT=60000

# OPTIONAL: Per-process minimum interval between crawl requests in milliseconds
# Multi-process / deep-crawl pacing belongs on the server.
# CRAWL4AI_MIN_REQUEST_INTERVAL_MS=1000

# Presentation uses fixed defaults, not environment configuration.
# Inline bodies: 12000 total characters; crawl_read: 6000 characters.
# Per-call preview parameters can lower crawl caps; host byte/line caps also apply.

# OPTIONAL: Default directory for complete saved crawl sessions (ctx.cwd-relative)
# save=false is the explicit no-write opt-out; omitted content is unrecoverable.
# CRAWL4AI_OUTPUT_DIR=./output-crawl4ai

# OPTIONAL: Explicit local Python with trafilatura>=2,<3 (basic crawl needs no Python)
# Operator setup: python3 -m venv ~/.venvs/pi-crawl4ai
# ~/.venvs/pi-crawl4ai/bin/python -m pip install 'trafilatura>=2,<3'
# JSON equivalent: "trafilatura": { "pythonPath": "/absolute/path/to/python" }
# CRAWL4AI_TRAFILATURA_PYTHON=/absolute/path/to/venv/bin/python
# Only receives server-rendered HTML stdin; no local network/browser or auto-install.
# Raw HTML is saved before extraction; native tables/links/formatting may be lost.
# extractor=trafilatura requires saving; includeLinks defaults false.

# Tools are controlled externally by /tools, presets and CLI/child allowlists.
# /crawl-status checks service health on demand only.
# Configured deadline/HTTP abort does not guarantee remote browser cancellation.

# OPTIONAL: Retention / cleanup for saved sessions (auto after each save)
# CRAWL4AI_RETENTION_ENABLED=true
# CRAWL4AI_RETENTION_MAX_SESSIONS=20
# CRAWL4AI_RETENTION_MAX_AGE_DAYS=7
# CRAWL4AI_RETENTION_MAX_TOTAL_MB=512
