# pi-crawl4ai Configuration
# Copy this file to .env or use a JSON config file (recommended)

# ============================================
# JSON CONFIG (RECOMMENDED)
# ============================================
# Create a JSON config file instead of env vars:
#
# Option 1: Project-level config
#   .pi/crawl4ai.json
#
# Option 2: Global config
#   ~/.pi/agent/extensions/crawl4ai.json
#
# Example JSON config:
# {
#   "url": "http://localhost:11235",
#   "timeoutMs": 60000,
#   "proxy": {
#     "url": "http://user:pass@proxy.example.com:8080"
#   },
#   "tools": ["crawl"]
# }
#
# Or with provider-specific proxy:
# {
#   "url": "http://localhost:11235",
#   "proxy": {
#     "provider": "oxylabs",
#     "username": "your_username",
#     "password": "your_password",
#     "host": "pr.oxylabs.io",
#     "port": 7777
#   }
# }

# ============================================
# ENVIRONMENT VARIABLES (FALLBACK)
# ============================================

# REQUIRED: crawl4ai Docker API URL or remote API URL
CRAWL4AI_BASE_URL=http://localhost:11235

# OPTIONAL: crawl4ai Docker/API bearer token (required when server auth is enabled)
# Sent as: Authorization: Bearer <token>
# CRAWL4AI_API_TOKEN=your-crawl4ai-api-token

# OPTIONAL: Request timeout in milliseconds
# CRAWL4AI_TIMEOUT=60000

# OPTIONAL: Minimum interval between crawl requests in milliseconds
# CRAWL4AI_MIN_REQUEST_INTERVAL_MS=1000

# OPTIONAL: Token-budget defaults for tool results returned to the model
# CRAWL4AI_MAX_CHARS_PER_PAGE=12000
# CRAWL4AI_MAX_CHARS_PER_CALL=40000
# CRAWL4AI_RETURN_MODE=auto
# CRAWL4AI_PREFER_FIT_MARKDOWN=true
# CRAWL4AI_DEEP_CRAWL_DEFAULT_MAX_PAGES=10
# CRAWL4AI_EXCERPT_CHARS=200

# OPTIONAL: Default directory for saved crawl sessions
# CRAWL4AI_OUTPUT_DIR=./output-crawl4ai

# OPTIONAL: Retention / cleanup for saved sessions (auto after each save)
# CRAWL4AI_RETENTION_ENABLED=true
# CRAWL4AI_RETENTION_MAX_SESSIONS=20
# CRAWL4AI_RETENTION_MAX_AGE_DAYS=7
# CRAWL4AI_RETENTION_MAX_TOTAL_MB=512

# ============================================
# PROXY OPTIONS (ENV VARS)
# ============================================

# Option 1: Full proxy URL with authentication
# Format: http://username:password@host:port
# CRAWL4AI_PROXY_URL=http://user:pass@proxy.example.com:8080

# Option 2: Oxylabs ISP proxy (auto-configured)
# If both PROXY_URL and OXYLABS_* are set, PROXY_URL takes precedence
# OXYLABS_USER=your_username
# OXYLABS_PASS=your_password
# OXYLABS_HOST=pr.oxylabs.io
# OXYLABS_PORT=7777
