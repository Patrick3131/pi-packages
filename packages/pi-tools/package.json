{
  "name": "pi-tools",
  "version": "0.1.0",
  "description": "Pi package that registers the official /tools command to enable and disable session tools",
  "type": "module",
  "scripts": {
    "build": "node -e \"process.exit(0)\"",
    "typecheck": "tsc --noEmit",
    "lint": "node -e \"process.exit(0)\"",
    "test": "node --import tsx --test --test-force-exit test/**/*.test.ts",
    "clean": "rm -rf coverage"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "tools"
  ],
  "author": "Patrick Fischer <patrick-fischer@live.de>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Patrick3131/pi-packages",
    "directory": "packages/pi-tools"
  },
  "bugs": {
    "url": "https://github.com/Patrick3131/pi-packages/issues"
  },
  "homepage": "https://github.com/Patrick3131/pi-packages#readme",
  "files": [
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/tools.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2"
  }
}
