{
  "name": "@patrick3131/pi-packages",
  "version": "0.1.8",
  "description": "Monorepo for Pi extensions",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces && npm run test:configs",
    "test:configs": "node --test configs/global/*.test.mjs",
    "test:coverage": "jest --coverage",
    "clean": "npm run clean --workspaces && rm -rf node_modules coverage",
    "typecheck:configs": "tsc --noEmit --strict --skipLibCheck --module nodenext --target ES2022 configs/global/mcp-policy.ts",
    "build:research": "tsup --config tsup.research.config.ts",
    "prepare": "node scripts/prepare-research.mjs",
    "prepack": "npm run build:research",
    "smoke:crawl": "node scripts/crawl-capability-smoke.mjs"
  },
  "pi": {
    "extensions": [
      "packages/pi-crawl4ai/src/index.ts",
      "packages/pi-delegation/src/index.ts",
      "packages/pi-toolkit/src/features/presets/index.ts",
      "packages/pi-discovery/src/index.ts",
      "packages/pi-toolkit/src/features/tools/index.ts",
      "packages/pi-toolkit/src/features/skill-mentions/index.ts",
      "packages/pi-toolkit/src/features/overview/index.ts",
      "packages/pi-recap/src/index.ts",
      "packages/pi-work/src/index.ts"
    ],
    "skills": [
      "packages/pi-work/skills"
    ],
    "subagents": {
      "agents": [
        "packages/pi-crawl4ai/agents"
      ]
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "jest": "^29.7.0",
    "tsup": "^8.0.0"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "coding-agent"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "exports": {
    "./research": {
      "types": "./dist/research.d.mts",
      "import": "./dist/research.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "packages/*/src/**",
    "packages/*/skills/**",
    "packages/*/agents/**",
    "packages/*/package.json",
    "README.md",
    "LICENSE",
    "packages/pi-work/scaffold/**",
    "scripts/prepare-research.mjs",
    "scripts/crawl-capability-smoke.mjs",
    "tsconfig.research.json",
    "tsup.research.config.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Patrick3131/pi-packages.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
